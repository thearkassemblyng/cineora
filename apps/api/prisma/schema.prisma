generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CREATOR
  PRODUCER
  ADMIN
}

enum CreditTransactionType {
  TOPUP
  RESERVE
  SETTLE
  REFUND
}

enum ProjectFormat {
  CINEMATIC_FILM
  ADVERTISEMENT
  NEWS_BROADCAST
  DOCUMENTARY
  SOCIAL_MEDIA
}

enum ResolutionPreset {
  P1080
  UHD_4K
}

enum GenerationMode {
  LIVE
  DEMO
}

enum QualityTier {
  STANDARD
  HIGH
  CINEMA_MASTER
}

enum GenerationStatus {
  QUEUED
  DISPATCHED
  PROCESSING
  QC_PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum AudioTrackType {
  VOICEOVER
  DIALOGUE
  MUSIC
  SFX
}

enum ExportPreset {
  CINEMA_4K
  BROADCAST_1080P
  WEB_MASTER
  SOCIAL_9_16
}

enum RenderStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  fullName     String
  role         UserRole       @default(CREATOR)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  wallet        CreditWallet?
  projects      Project[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditWallet {
  id              String              @id @default(cuid())
  userId          String              @unique
  availableCredits Int                @default(0)
  reservedCredits  Int                @default(0)
  updatedAt       DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id             String                @id @default(cuid())
  walletId       String
  type           CreditTransactionType
  amount         Int
  idempotencyKey String                @unique
  referenceType  String?
  referenceId    String?
  notes          String?
  createdAt      DateTime              @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Project {
  id               String           @id @default(cuid())
  ownerId          String
  title            String
  description      String?
  format           ProjectFormat    @default(CINEMATIC_FILM)
  aspectRatio      String           @default("16:9")
  targetResolution ResolutionPreset @default(P1080)
  targetFps        Int              @default(24)
  colorProfile     String           @default("REC709_FILMIC")
  styleBibleNotes  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  characters CharacterAsset[]
  scenes     Scene[]
  audioTracks AudioTrack[]
  renders    RenderJob[]

  @@index([ownerId, updatedAt])
}

model CharacterAsset {
  id               String   @id @default(cuid())
  projectId        String
  name             String
  appearanceNotes  String
  wardrobeNotes    String?
  referenceImageUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Scene {
  id                 String   @id @default(cuid())
  projectId          String
  orderIndex         Int
  title              String
  scriptNarration    String?
  visualPrompt       String
  shotType           String   @default("MEDIUM")
  cameraMovement     String   @default("TRACKING")
  lightingPreset     String   @default("NATURAL_GOLDEN_HOUR")
  durationSeconds    Int      @default(5)
  continuityNotes    String?
  activeGenerationId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@index([projectId, orderIndex])
}

model Generation {
  id                  String           @id @default(cuid())
  sceneId             String
  mode                GenerationMode   @default(LIVE)
  provider            String
  model               String
  qualityTier         QualityTier      @default(HIGH)
  resolution          String           @default("1080P")
  fps                 Int              @default(24)
  seed                Int?
  compiledPrompt      String
  providerJobId       String?
  status              GenerationStatus @default(QUEUED)
  errorCode           String?
  errorMessage        String?
  rawAssetKey         String?
  enhancedAssetKey    String?
  creditReservationId String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  qualityReport QualityReport?

  @@index([sceneId, createdAt])
  @@index([status])
}

model QualityReport {
  id              String   @id @default(cuid())
  generationId    String   @unique
  width           Int
  height          Int
  fps             Float
  bitrateKbps     Int?
  sharpnessScore  Float
  flickerScore    Float
  avSyncOffsetMs  Float
  artifactFlags   String[]
  passed          Boolean
  recommendations String[]
  analyzedAt      DateTime @default(now())

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
}

model AudioTrack {
  id            String         @id @default(cuid())
  projectId     String
  sceneId       String?
  type          AudioTrackType
  provider      String?
  voiceId       String?
  gainDb        Float          @default(0)
  startOffsetMs Int            @default(0)
  assetKey      String
  createdAt     DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RenderJob {
  id                 String       @id @default(cuid())
  projectId          String
  exportPreset       ExportPreset @default(WEB_MASTER)
  loudnessTargetLufs Float        @default(-14)
  status             RenderStatus @default(QUEUED)
  progressPct        Int          @default(0)
  outputAssetKey     String?
  cdnUrl             String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
