# ==============================================================================
# CINEORA — Environment Variable Template
# Copy to .env and fill in real values. NEVER commit real secrets to git.
# ==============================================================================

NODE_ENV=development

# --- Core Backend API (apps/api - NestJS) ---
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# --- Web Studio (apps/web - Next.js) ---
# Public browser-safe URL ONLY. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Database (PostgreSQL + Prisma) ---
DATABASE_URL=postgresql://cineora:cineora_dev_password@localhost:5432/cineora?schema=public

# --- Redis & BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentication (JWT) ---
JWT_ACCESS_SECRET=replace-with-strong-random-64-char-secret
JWT_REFRESH_SECRET=replace-with-different-strong-random-64-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Object Storage (AWS S3 / Local MinIO) & CloudFront ---
S3_REGION=us-east-1
S3_BUCKET=cineora-media
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=cineora_minio_user
AWS_SECRET_ACCESS_KEY=cineora_minio_password
CLOUDFRONT_DOMAIN=

# --- Internal Service Communication ---
AI_ORCHESTRATOR_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=replace-with-shared-internal-service-token

# --- AI Orchestrator (services/ai-orchestrator - FastAPI) ---
AI_ORCHESTRATOR_PORT=8000
AI_DEFAULT_MODE=DEMO

# --- Live AI Video & Audio Provider API Keys (Server-Side Only) ---
# Leave blank if not configured; CINEORA will honestly report unconfigured providers.
GOOGLE_VEO_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
LUMA_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Media Worker (services/media-worker - FFmpeg + QC) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_WORKER_CONCURRENCY=2
TEMP_MEDIA_DIR=./tmp/media
